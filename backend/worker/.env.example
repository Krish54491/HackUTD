# --- NVIDIA Nemotron (required for the AI agent; without it the worker runs rules-only) ---
# Get a key at https://build.nvidia.com (it starts with "nvapi-").
NVIDIA_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b     # investigator agent (plan, tools, verdict)
# NEMOTRON_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b # used automatically if the agent model is unavailable
# NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b # bulk listing triage
# NEMOTRON_THINKING=                                         # unset = reasoning on for plan + verdict only; 0 = always off (fastest); 1 = always on

# --- Web search for the agent (optional, first one set wins; falls back to DuckDuckGo/Wikipedia) ---
# TAVILY_API_KEY=        # free tier at https://tavily.com
# BRAVE_SEARCH_API_KEY=  # https://brave.com/search/api

# --- Other signals ---
GOOGLE_SAFE_BROWSING_KEY=

# --- SpacetimeDB ---
# SPACETIME_HOST=https://maincloud.spacetimedb.com
# SPACETIME_DB=protego

# --- Tuning ---
# INVESTIGATION_TIMEOUT_MS=60000
# MAX_PARALLEL=6
# MAX_BATCHES=4
# POLL_MS=750
# DISABLE_LLM=1
