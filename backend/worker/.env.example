# SpacetimeDB
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=protego
# Optional: reuse a fixed identity instead of the auto-created .worker-identity.json
# WORKER_IDENTITY=
# WORKER_TOKEN=

# Claude (risk agent + listing classifier). Without it the worker runs heuristics only.
ANTHROPIC_API_KEY=

# Optional: Google Safe Browsing v4 key
GOOGLE_SAFE_BROWSING_KEY=
